
program         ::= { struct } { fn } { statement NL } exit [ NL ]
struct          ::= "struct" ident NL "{" NL field_decl { field_decl } { member_fn } "}" NL
field_decl      ::= type [ "mut" ] ident NL
member_fn       ::= fn
fn              ::= "fn" ident ":=" "(" [ type ident { "," type ident } ] ")" "->" type NL function_block
function_block  ::= "{" NL { statement NL } exit NL "}" NL
block           ::= "{" NL ( exit NL | statement NL { statement NL } [ exit NL ] ) "}" NL

statement       ::= decl | assign | if | while | print | lambda
lambda          ::= "fn" ident ":=" "[" [ capture { "," capture } ] "]" "(" [ type ident { "," type ident } ] ")" "->" type NL block
capture         ::= [ "mut" ] ident
print           ::= "print" "(" ( string | expr ) ")"
string          ::= '"' { any byte except '"' and NL } '"'

read_call       ::= "read" "(" ")"
decl            ::= type [ "mut" ] ident "{" [ init { "," init } ] "}"
init            ::= expr | "{" [ init { "," init } ] "}"
type            ::= "i32" | "i64" | "bool" | ident
assign          ::= assign_target ":=" expr
assign_target   ::= ident { "." ident }

exit            ::= "exit" factor
if              ::= "if" expr NL block [ "else" NL block ]
while           ::= "while" expr NL block
expr            ::= arith [ ( "==" | "!=" ) arith ]
arith           ::= term { ( "+" | "-" ) term }
term            ::= factor { "*" factor }
factor          ::= "!" factor | number | "true" | "false" | postfix

postfix         ::= ( ident | call | read_call ) { "." ident [ call_args ] }
call            ::= ident call_args
call_args       ::= "(" [ expr { "," expr } ] ")"





