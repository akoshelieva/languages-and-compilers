Program
  Function helper -> i32
    Exit
      Const 2
  Function dead -> i32
    Exit
      Const 99
  If
    Bool true
    Block
      Decl x i32 const
        Const 9
      Lambda show -> i32
        Struct lambda.show
          Field x i32 const
          MemberFn call -> i32
            Block
              Decl result i32 const
                BinOp +
                  Var x
                  Call helper
              Exit
                Var result
        Decl show lambda.show const
          Var x
      Lambda unused -> i32
        Struct lambda.unused
          Field x i32 const
          MemberFn call -> i32
            Block
              Decl result i32 const
                BinOp +
                  Var x
                  Call dead
              Exit
                Var result
        Decl unused lambda.unused const
          Var x
      Print
        CallableCall show
          Var show
  Exit
    Const 0
